# CF pre-push hook configuration
# Copy this file to .env and adjust values as needed.

# The CF stack that must be targeted (e.g. cflinuxfs4)
CF_REQUIRED_STACK=cflinuxfs4

# The CF buildpack name to check against
CF_REQUIRED_BUILDPACK=nodejs_buildpack

# Base URL for the raw manifest.yml in the cloudfoundry/nodejs-buildpack GitHub repo
CF_RAW_MANIFEST_BASE=https://raw.githubusercontent.com/cloudfoundry/nodejs-buildpack
